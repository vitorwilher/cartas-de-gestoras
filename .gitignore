.env
.venv/
__pycache__/
*.pyc
.DS_Store
.Rhistory

# Capturas e respostas usadas apenas durante o desenvolvimento dos coletores
/al.html
/ars.xml
/df.xml
/dm.json
/dyn.html
/dyn2.html
/ip.html
/ipf.xml
/media.json
/WhatsApp Image *.jpeg
