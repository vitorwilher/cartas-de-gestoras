# Artefatos intermediários do Quarto (PDFs e .qmd ficam versionados como arquivo)
*_files/
*.html
!digests/**/*.pdf

# PDFs brutos das cartas baixadas das gestoras: binários pesados e
# redistribuíveis apenas pela fonte original. O texto extraído e os metadados
# (gestoras/gestoras.yml) ficam versionados; o PDF original, não.
cartas/**/*.pdf

# MCP (Cloudflare Worker): dependências e artefatos de build
mcp/node_modules/
mcp/dist/
mcp/.wrangler/

# Cache do Quarto
.quarto/

# Carrossel: HTML intermediário (os PNGs ficam versionados como entregável)
divulgacao/carrossel/carrossel.html

# Worker de escuta: dependências e build
divulgacao/whatsapp/escuta/node_modules/
divulgacao/whatsapp/escuta/.wrangler/
