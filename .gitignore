.env
.venv/
__pycache__/
*.pyc
.DS_Store
.Rhistory

# Capturas e respostas usadas apenas durante o desenvolvimento dos coletores
/al.html
/ars.xml
/df.xml
/dm.json
/dyn.html
/dyn2.html
/ip.html
/ipf.xml
/media.json
/WhatsApp Image *.jpeg
/docs_post-instagram-peruffo.jpeg

# Artefatos intermediários do Quarto (PDFs e .qmd ficam versionados como arquivo)
*_files/
*.html
!digests/**/*.pdf

# PDFs brutos das cartas baixadas das gestoras: binários pesados e
# redistribuíveis apenas pela fonte original. O texto extraído e os metadados
# (gestoras/gestoras.yml) ficam versionados; o PDF original, não.
cartas/**/*.pdf

# MCP (Cloudflare Worker): dependências e artefatos de build
mcp/node_modules/
mcp/dist/
mcp/.wrangler/

# Cache do Quarto
.quarto/

# Carrossel: HTML intermediário (os PNGs ficam versionados como entregável)
divulgacao/carrossel/carrossel.html

# Worker de escuta: dependências e build
divulgacao/whatsapp/escuta/node_modules/
divulgacao/whatsapp/escuta/.wrangler/

# Artefatos de render do paper
paper/paper_files/
paper/.quarto/

# Análises: os dados BRUTOS da CVM não são versionados (70 MB, redistribuição é
# da CVM, e o download é reprodutível pelos scripts). Versionamos os DERIVADOS:
# os scripts, o relatório e — importante — `peso_das_teses_prompt.txt`, que a
# síntese lê em tempo de execução na CI.
analises/cad_fi.csv
analises/cad_adm_cart_*.csv
analises/registro_*.csv
analises/*.zip
# Contém nome, cargo e perfil de pessoas reais (LGPD): fica só local.
analises/linkedin_x_gestoras.csv
