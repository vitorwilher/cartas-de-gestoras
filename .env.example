ANTHROPIC_API_KEY=sk-ant-...

# Meta WhatsApp Cloud API (só usado com --send)
# Reaproveita a infraestrutura já validada no projeto Newsletters: mesmo número
# de produção (WABA "Análise Macro"), mesmo System User token sem expiração.
WHATSAPP_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=1234567890123456
WHATSAPP_TO_NUMBER=5511999999999
WHATSAPP_WABA_ID=1421867178829333

# Nome do template usado para enviar o PDF das cartas. Deve ter header `document`
# + body {{1}} (data), {{2}} (gestoras) e {{3}} (resumo executivo). Categoria UTILITY:
# foge do frequency cap de MARKETING da Meta, que descarta em silêncio (a API
# ainda responde `accepted`). Ver CLAUDE.md, seção WhatsApp Cloud API.
WHATSAPP_CARTAS_TEMPLATE=sintese_cartas_gestoras
